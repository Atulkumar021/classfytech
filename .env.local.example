# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real credentials.

# Gmail account the site sends notification emails through.
# GMAIL_APP_PASSWORD must be a 16-character App Password (requires 2-Step
# Verification on that account, not the normal Gmail password).
# Generate one at https://myaccount.google.com/apppasswords
GMAIL_USER=atulp3655@gmail.com
GMAIL_APP_PASSWORD=

# Optional — where form submissions are delivered. Defaults to
# classifytechnologies@gmail.com if unset.
CONTACT_TO_EMAIL=classifytechnologies@gmail.com
