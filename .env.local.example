# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real credentials.

# SMTP server that will send the outgoing mail.
# For Gmail: host smtp.gmail.com, port 587, and SMTP_PASS must be a 16-character
# App Password (requires 2-Step Verification), not your normal Gmail password.
# Generate one at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=classifytechnologies@gmail.com
SMTP_PASS=

# Optional — defaults to SMTP_USER / classifytechnologies@gmail.com if unset.
SMTP_FROM=classifytechnologies@gmail.com
CONTACT_TO_EMAIL=classifytechnologies@gmail.com
